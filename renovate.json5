{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  minimumReleaseAge: "7 days",
  customManagers: [
    {
      customType: "regex",
      description: "Track the Graphcal CLI version installed by setup-graphcal",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "uses: graphcal-lang/setup-graphcal@[^\\n]*\\n\\s*with:\\n\\s*version: (?<currentValue>[^\\s]+)",
      ],
      depNameTemplate: "graphcal",
      datasourceTemplate: "crate",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Track the gh-actions-lock version used to verify the actions lockfile",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["gh extension install github/gh-actions-lock --pin (?<currentValue>v[^\\s]+)"],
      depNameTemplate: "github/gh-actions-lock",
      datasourceTemplate: "github-releases",
    },
  ],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      // .github/workflows/actions.lock pins action commits; gh actions-lock strips inline digests.
      description: "Use the actions lockfile instead of inline digest pins",
      matchManagers: ["github-actions"],
      pinDigests: false,
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      // Follow graphcal's policy until Cargo min-publish-age is stable.
      description: "Disable Renovate cooldown for Cargo crates until Cargo min-publish-age is stable",
      matchManagers: ["cargo"],
      matchDatasources: ["crate"],
      minimumReleaseAge: null,
    },
    {
      // The CLI used by the end-to-end CI job must match the client crate.
      description: "Bump the Graphcal crates and the CI's Graphcal CLI together",
      matchPackageNames: ["graphcal", "graphcal-model-client", "graphcal-model-protocol"],
      groupName: "graphcal",
      groupSingleUpdates: true,
      // Same cooldown as the Cargo crates, so the group is not split.
      minimumReleaseAge: null,
    },
    {
      matchManagers: ["rust-toolchain"],
      matchDepTypes: ["toolchain"],
      addLabels: ["rust", "ci"],
    },
  ],
}
