{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>shunichironomura/renovate-config"],
  customManagers: [
    {
      customType: "regex",
      description: "Track the Graphcal CLI version installed by setup-graphcal",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "uses: graphcal-lang/setup-graphcal@[^\\n]*\\n\\s*with:\\n\\s*version: (?<currentValue>[^\\s]+)",
      ],
      depNameTemplate: "graphcal",
      datasourceTemplate: "crate",
      versioningTemplate: "semver",
    },
  ],
  packageRules: [
    {
      // The CLI used by the end-to-end CI job must match the client crate.
      description: "Bump the Graphcal crates and the CI's Graphcal CLI together",
      matchPackageNames: ["graphcal", "graphcal-model-client", "graphcal-model-protocol"],
      groupName: "graphcal",
      groupSingleUpdates: true,
    },
    {
      matchManagers: ["rust-toolchain"],
      matchDepTypes: ["toolchain"],
      addLabels: ["rust", "ci"],
    },
  ],
}
